{
  "name": "uu889-drama-desktop",
  "productName": "UU889Drama",
  "version": "1.0.4",
  "private": true,
  "description": "UU889-Drama 桌面版（Electron 壳）",
  "author": "UU889",
  "main": "dist/main.js",
  "scripts": {
    "build:backend": "node scripts/build-backend.mjs",
    "build:main": "node scripts/build-main.mjs",
    "rebuild:native": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dev": "npm run build:backend && npm run build:main && electron .",
    "dist": "npm run build:backend && npm run build:main && node scripts/prepare-resources.mjs && electron-builder --mac",
    "dist:win": "npm run build:backend && npm run build:main && node scripts/prepare-resources.mjs && electron-builder --win",
    "feed": "node scripts/make-update-feed.mjs",
    "publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "37.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "optionalDependencies": {
    "@img/sharp-win32-x64": "^0.34.5"
  }
}
